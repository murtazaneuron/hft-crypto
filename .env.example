# hft-crypto - environment variable template
# Copy to .env and fill in real values.
# NEVER commit the .env file - it is gitignored.

# ── AI Agent (Rig / ARC) ──────────────────────────────────────────────────────
# Required only for --features ai-agent builds
ANTHROPIC_API_KEY=

# ── Binance ───────────────────────────────────────────────────────────────────
# https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Kraken ────────────────────────────────────────────────────────────────────
# https://www.kraken.com/u/security/api
# Note: Kraken API secret must be base64-encoded before use in this library
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ── OKX ───────────────────────────────────────────────────────────────────────
# https://www.okx.com/account/my-api
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# ── Bybit ─────────────────────────────────────────────────────────────────────
# https://www.bybit.com/app/user/api-management
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ── Coinbase Advanced Trade ───────────────────────────────────────────────────
# https://www.coinbase.com/settings/api
COINBASE_API_KEY=
COINBASE_API_SECRET=

# ── KuCoin ────────────────────────────────────────────────────────────────────
# https://www.kucoin.com/account/api
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSPHRASE=

# ── Hyperliquid ───────────────────────────────────────────────────────────────
# 64-character hex Ed25519 seed (your wallet private key)
# Generate with: openssl rand -hex 32
HYPERLIQUID_PRIVATE_KEY=

# ── Dry-run mode ──────────────────────────────────────────────────────────────
# Set to "true" to prevent any live order submission (default behaviour
# when exchange env vars are absent)
DRY_RUN=true
